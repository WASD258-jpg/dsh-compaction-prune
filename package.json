{
  "name": "dsh-compaction-prune",
  "version": "0.1.0",
  "type": "module",
  "description": "Proactive tool-result pruning for DeepSeek Harness: reduce how often automatic compaction fires, so a failing compaction has fewer chances to fail",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LIMITATIONS.md",
    "LIMITATIONS.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "compaction",
    "context-management",
    "pruning"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "node tests/decide.spec.mjs && node tests/mount.spec.mjs && node tests/config-loading.spec.mjs",
    "test:a1": "node tests/a1-mechanism.spec.mjs",
    "test:failure-modes": "node tools/failure-modes.mjs",
    "test:a2-selftest": "node tools/a2-counterfactual.mjs --selftest --manifest",
    "test:report": "node tools/verify-report.mjs",
    "test:docs": "node tools/check-language-pairs.mjs && node tools/check-links.mjs",
    "corpus:pin": "node tools/corpus.mjs build",
    "corpus:show": "node tools/corpus.mjs show",
    "a2": "node tools/a2-counterfactual.mjs --manifest",
    "a2:sweep": "node tools/a2-counterfactual.mjs --sweep",
    "recon": "node tools/recon.mjs",
    "trace": "node tools/trace.mjs",
    "decompose": "node tools/decompose.mjs",
    "trigger-audit": "node tools/trigger-audit.mjs"
  }
}
